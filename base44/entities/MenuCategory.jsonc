{
  "name": "MenuCategory",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Slug-key die MenuKnowledge-items refereren (bijv. 'signature', 'lunch'). Uniek."
    },
    "label": {
      "type": "string",
      "description": "Weergavenaam van de menusectie (Nederlands), bijv. 'Signature', 'Voorgerechten'."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Weergavevolgorde op de menukaart."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Of deze sectie actief/getoond wordt."
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}