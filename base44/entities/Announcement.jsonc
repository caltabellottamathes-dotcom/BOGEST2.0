{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Korte titel van de melding"
    },
    "message": {
      "type": "string",
      "description": "Meldingstekst die op de site verschijnt"
    },
    "link_label": {
      "type": "string",
      "description": "Optioneel knoplabel bijv. 'Reserveer' of 'Lees meer'"
    },
    "link_url": {
      "type": "string",
      "description": "Optionele interne of externe link"
    },
    "location": {
      "type": "string",
      "enum": [
        "all",
        "hasselt",
        "borgloon",
        "heusden-zolder"
      ],
      "default": "all",
      "description": "Voor welke vestiging de melding geldt (all = alle)"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Vanaf wanneer zichtbaar (leeg = onmiddellijk)"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Automatisch verbergen na deze datum"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Handmatig in/uit-schakelen"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Weergavevolgorde"
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}