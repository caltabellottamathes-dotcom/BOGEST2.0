{
  "name": "MenuKnowledge",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "signature",
        "beef",
        "chicken",
        "fish",
        "veggie",
        "sides",
        "sauces",
        "wines",
        "beers",
        "drinks",
        "desserts",
        "kids"
      ],
      "description": "Menu category"
    },
    "item_name": {
      "type": "string",
      "description": "Display name of the item"
    },
    "description": {
      "type": "string",
      "description": "Short description of the item"
    },
    "price": {
      "type": "number",
      "description": "Price in EUR"
    },
    "pairing": {
      "type": "string",
      "description": "Recommended wine/beer/drink pairing"
    },
    "is_popular": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a popular/highlighted item"
    },
    "is_new": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a new/seasonal item"
    },
    "available_locations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hasselt",
          "borgloon",
          "heusden-zolder"
        ]
      },
      "description": "Locations where this item is available (empty = all)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within category"
    }
  },
  "required": [
    "category",
    "item_name"
  ]
}