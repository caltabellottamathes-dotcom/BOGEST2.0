{
  "name": "MenuKnowledge",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "description": "Menu category key \u2014 referentie naar MenuCategory (bijv. 'signature', 'beef', 'lunch'). Vrije tekst zodat admin-gemaakte categorie\u00ebn werken."
    },
    "item_name": {
      "type": "string",
      "description": "Display name of the item (Dutch canonical name)"
    },
    "description": {
      "type": "string",
      "description": "Short description of the item"
    },
    "price": {
      "type": "number",
      "description": "Price in EUR (null/omitted = included in the formula)"
    },
    "pairing": {
      "type": "string",
      "description": "Recommended wine/beer/drink pairing"
    },
    "is_popular": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a popular/highlighted item"
    },
    "is_new": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a new/seasonal item"
    },
    "available_locations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hasselt",
          "borgloon",
          "heusden-zolder"
        ]
      },
      "description": "Locations where this item is available (empty = all)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within category"
    }
  },
  "required": [
    "category",
    "item_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}