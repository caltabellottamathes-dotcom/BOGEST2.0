{
  "name": "VoiceAgentState",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "ElevenLabs Conversational AI agent id this state tracks"
    },
    "mode": {
      "type": "string",
      "enum": [
        "elevenlabs_native",
        "base44_fallback"
      ],
      "description": "Which LLM backend the agent is currently pointed at"
    },
    "native_llm": {
      "type": "string",
      "description": "Snapshot of the ElevenLabs native model string (e.g. gemini-2.5-flash) to restore to"
    },
    "remaining_credits": {
      "type": "number",
      "description": "Last computed remaining characters (credits)"
    },
    "character_count": {
      "type": "number"
    },
    "character_limit": {
      "type": "number"
    },
    "last_check": {
      "type": "string",
      "format": "date-time"
    },
    "last_switch": {
      "type": "string",
      "format": "date-time"
    },
    "last_switch_direction": {
      "type": "string",
      "description": "to_fallback | to_native"
    }
  },
  "required": [
    "agent_id",
    "mode"
  ]
}