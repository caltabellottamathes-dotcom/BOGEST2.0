{
  "name": "Job",
  "type": "object",
  "properties": {
    "title_nl": {
      "type": "string",
      "description": "Functietitel (Nederlands)"
    },
    "title_fr": {
      "type": "string",
      "description": "Functietitel (Frans)"
    },
    "title_en": {
      "type": "string",
      "description": "Functietitel (Engels)"
    },
    "location_name": {
      "type": "string",
      "description": "Weergavenaam van de vestiging, bijv. 'Bog\u00e8st Hasselt'"
    },
    "location_slug": {
      "type": "string",
      "enum": [
        "hasselt",
        "borgloon",
        "heusden-zolder"
      ],
      "description": "Vestiging-slug voor koppeling"
    },
    "type_nl": {
      "type": "string"
    },
    "type_fr": {
      "type": "string"
    },
    "type_en": {
      "type": "string"
    },
    "desc_nl": {
      "type": "string",
      "description": "Korte beschrijving (Nederlands)"
    },
    "desc_fr": {
      "type": "string"
    },
    "desc_en": {
      "type": "string"
    },
    "full_text_nl": {
      "type": "string",
      "description": "Volledige vacaturetekst (Nederlands)"
    },
    "full_text_fr": {
      "type": "string"
    },
    "full_text_en": {
      "type": "string"
    },
    "apply_email": {
      "type": "string",
      "description": "Sollicitatie-e-mailadres"
    },
    "apply_phone": {
      "type": "string",
      "description": "Sollicitatie-telefoonnummer"
    },
    "walk_in": {
      "type": "string",
      "description": "Contactpersoon voor langskomen, bijv. 'Marah (Hasselt)'"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title_nl",
    "location_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}