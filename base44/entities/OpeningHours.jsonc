{
  "name": "OpeningHours",
  "type": "object",
  "properties": {
    "location": {
      "type": "string",
      "enum": [
        "hasselt",
        "borgloon",
        "heusden-zolder"
      ],
      "description": "Vestiging"
    },
    "day_index": {
      "type": "number",
      "description": "0 = maandag ... 6 = zondag"
    },
    "hours_text": {
      "type": "string",
      "description": "Weergave zoals op de site, bijv. '17:00 \u2013 22:00' of 'Gesloten'"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "location",
    "day_index",
    "hours_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}