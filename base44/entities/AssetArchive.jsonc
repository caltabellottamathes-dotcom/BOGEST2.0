{
  "name": "AssetArchive",
  "type": "object",
  "properties": {
    "content_hash": {
      "type": "string",
      "description": "SHA-256 of the image bytes \u2014 exact-duplicate key"
    },
    "phash": {
      "type": "string",
      "description": "64-bit perceptual (average) hash for near-duplicate detection"
    },
    "source_url": {
      "type": "string",
      "description": "Primary URL where the image was first discovered"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All public URLs where this (near-)duplicate image was found"
    },
    "search_query": {
      "type": "string",
      "description": "Discovery query that surfaced this asset"
    },
    "image_url": {
      "type": "string",
      "description": "CDN URL used to display the image (mirrored to Base44 storage, or the source CDN)"
    },
    "mirrored": {
      "type": "boolean",
      "default": false,
      "description": "Whether the image was copied into Base44 CDN storage"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multi-category assignment as 'group/Sub' paths (e.g. 'food/Main Courses', 'atmosphere/Evening', 'locations/Hasselt'). An image may belong to several categories \u2014 it is never restricted to one."
    },
    "primary_category": {
      "type": "string",
      "enum": [
        "interiors",
        "gastronomy",
        "atmosphere",
        "architecture",
        "branding"
      ],
      "description": "Legacy single bucket \u2014 derived from categories for backward compatibility. Optional."
    },
    "subcategory": {
      "type": "string",
      "description": "Legacy fine-grained AI label (kept for backward compatibility)"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "landscape",
        "portrait",
        "square",
        "unknown"
      ],
      "default": "unknown",
      "description": "Auto-derived from width/height"
    },
    "source_platform": {
      "type": "string",
      "description": "Where the image was discovered (Official Website, Google Maps, Tripadvisor, Instagram, Facebook, TikTok, Pinterest, Blog, News, Review Website)"
    },
    "location": {
      "type": "string",
      "enum": [
        "hasselt",
        "borgloon",
        "heusden-zolder",
        "unknown"
      ],
      "default": "unknown",
      "description": "Inferred Bog\u00e8st location"
    },
    "description": {
      "type": "string",
      "description": "AI-generated detailed description"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unlimited AI-generated descriptive tags for natural-language search"
    },
    "mood": {
      "type": "string",
      "description": "Detected mood"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dominant colors"
    },
    "is_relevant": {
      "type": "boolean",
      "default": true,
      "description": "Whether the image is relevant to Bog\u00e8st"
    },
    "quality_score": {
      "type": "number",
      "description": "AI quality score 0-100"
    },
    "width": {
      "type": "number",
      "description": "Image width in px"
    },
    "height": {
      "type": "number",
      "description": "Image height in px"
    },
    "theme": {
      "type": "string",
      "description": "Discovery theme that found this asset"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "web",
        "instagram",
        "seed"
      ],
      "default": "web",
      "description": "Where the asset was discovered"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "rejected"
      ],
      "default": "active"
    },
    "ai_analyzed": {
      "type": "boolean",
      "default": false,
      "description": "Whether AI analysis (description, categories, tags, mood, quality) has been run on this asset. Quick-uploaded assets start false until manually analysed."
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User-assigned collections for use in site content (e.g. seasonal_dishes, signature, terrace, events, hero)"
    },
    "matched_dish": {
      "type": "string",
      "description": "The single MenuKnowledge item_name this food photo is linked to, so the digital host and voice agent can show a real photo for a specific dish"
    }
  },
  "required": [
    "image_url"
  ]
}