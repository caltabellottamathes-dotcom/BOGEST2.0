{
  "description": "Daily growth of the Bog\u00e8st Universal Asset Archive: refresh known sources (website seeds + Instagram), then run automatic site-scoped SerpApi discovery across TripAdvisor, Instagram, Facebook, bogest.be and d-entrecote.be \u2014 dedup (content + perceptual hash) + vision filter + auto-import only new, unique, relevant photos.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_asset_discovery",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_known_sources": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverAssets",
            "args": {
              "theme": "all",
              "limit": 2
            }
          },
          "then": "auto_site_discovery",
          "x-base44": {
            "title": "Known sources refresh",
            "description": "Refresh website seeds + Instagram posts"
          }
        }
      },
      {
        "auto_site_discovery": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverAssets",
            "args": {
              "auto": true,
              "limit": 12
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Automatic site-scoped discovery",
            "description": "SerpApi google_images per site (TripAdvisor, Instagram, Facebook, bogest.be, d-entrecote.be) \u2192 dedup + vision filter \u2192 auto-import only new unique relevant photos"
          }
        }
      }
    ]
  },
  "name": "Daily Asset Discovery"
}