{
  "description": "Daily growth of the Bog\u00e8st Universal Asset Archive: refresh known sources (website seeds + Instagram), then search the public web for new Bog\u00e8st photos across review sites, blogs, news, travel & social.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_asset_discovery",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh_known_sources": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverAssets",
            "args": {
              "theme": "all",
              "limit": 2
            }
          },
          "then": "broad_web_search",
          "x-base44": {
            "title": "Known sources refresh",
            "description": "Refresh website seeds + Instagram posts"
          }
        }
      },
      {
        "broad_web_search": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverAssets",
            "args": {
              "web": true,
              "limit": 6
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Broad public-web discovery",
            "description": "Search the open web for new Bog\u00e8st photos (rotating queries)"
          }
        }
      }
    ]
  },
  "name": "Daily Asset Discovery"
}