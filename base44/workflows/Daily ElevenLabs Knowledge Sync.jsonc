  "name": "Daily ElevenLabs Knowledge Sync",
  "description": "Regenereert elke nacht het live-kennisblok (menu, uren, vacatures, mededelingen) in de ElevenLabs voice-agent-prompt vanuit de Base44-entiteiten, zodat de voice-host altijd de actuele prijzen, uren en vacatures uitspreekt.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_elevenlabs_knowledge_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_knowledge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncElevenLabsKnowledge",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Voice-agent live-kennis verversen",
            "description": "Menu, uren, vacatures, mededelingen \u2192 ElevenLabs-prompt"
          }
        }
      }
    ]
  }
}