{
  "name": "Daily Retention Sweep",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_retention_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "systemTools",
            "args": {
              "action": "retentionSweep"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Retention sweep",
            "description": "Purge expired preferences & consent"
          }
        }
      }
    ]
  },
  "description": "Purges expired visitor preferences and consent records daily at 03:00 (Europe/Amsterdam) per the per-field retention policy.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Amsterdam",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}